# Local PostgreSQL used by compose.yaml and compose.web.yaml.
POSTGRES_DB=job_radar
POSTGRES_USER=job_radar
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional when running main.py directly instead of through Docker Compose.
DATABASE_URL=postgresql://job_radar:replace-with-a-long-random-password@localhost:5432/job_radar
