# Local PostgreSQL used by compose.yaml and compose.web.yaml.
POSTGRES_DB=job_radar
POSTGRES_USER=job_radar
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Optional when running main.py directly instead of through Docker Compose.
DATABASE_URL=postgresql://job_radar:replace-with-a-long-random-password@localhost:5432/job_radar

# Email notifications through Resend. Leave RESEND_API_KEY empty to disable
# notifications locally. Configure these values as GitHub Actions secrets in
# production; do not commit a real API key or personal email address.
RESEND_API_KEY=
NOTIFICATION_EMAIL=recipient@example.com
NOTIFICATION_FROM="Job Radar <onboarding@resend.dev>"
