# Server-side only. Required on Vercel and must use a SELECT-only PostgreSQL role.
# Keep DATABASE_URL as the local-development fallback used by Docker Compose.
# Never prefix either value with NEXT_PUBLIC_.
WEB_DATABASE_URL=postgresql://job_radar_web:replace-with-a-long-random-password@localhost:5432/job_radar
DATABASE_URL=postgresql://job_radar:replace-with-a-long-random-password@localhost:5432/job_radar
